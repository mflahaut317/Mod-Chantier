{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Potes",
  "version": "1.0.0",
  "identifier": "fr.maxence.pixelpotes",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pixel Potes",
        "width": 1060,
        "height": 660,
        "minWidth": 880,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Maxence",
    "shortDescription": "Launcher de la survie entre potes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
